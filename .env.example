# Port Server Lokal
PORT=3000

# Mode Autentikasi Google: 'oauth' atau 'service_account'
GOOGLE_AUTH_MODE=oauth

# Konfigurasi Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Token Penyimpanan (Otomatis disimpan saat login OAuth pertama kali)
GOOGLE_REFRESH_TOKEN=

# Opsional: Jika menggunakan Service Account
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials.json
